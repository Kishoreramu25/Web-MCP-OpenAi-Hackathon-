{
  "manifest_version": 3,
  "name": "Google Form Auto-Filler & AI Submitter",
  "version": "2.0",
  "description": "Inspects Google Forms HTML, AI matches fields, injects directly into DOM, and auto-submits.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://forms.google.com/*",
    "https://forms.gle/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Form Auto-Filler"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/forms/*",
        "https://forms.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
