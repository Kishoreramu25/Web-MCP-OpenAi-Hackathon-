# ========= GEMINI API =========
GEMINI_API_KEY=your_gemini_api_key_here

# ========= SERVER CONFIG =========
FLASK_ENV=production
DEBUG=False
PORT=3000

# ========= SECURITY =========
# REQUIRED in production
API_KEYS=your-secure-api-key-here,another-key

# REQUIRED in production (comma-separated)
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://another-domain.com

# ========= DATABASE =========
DATABASE_URL=sqlite:///forms.db

# ========= NOTES =========
# 1. NEVER set DEBUG=True in production
# 2. Generate unique API keys for each deployment
# 3. ALLOWED_ORIGINS must be explicitly set in production
# 4. Store actual keys in secure secret management, not in .env files
