# ========= GEMINI API =========
GEMINI_API_KEY=your_gemini_key

# ========= SERVER =========
FLASK_ENV=production
DEBUG=False
PORT=3000

# ========= SECURITY (REQUIRED in production) =========
# Generate secure keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=secure-key-1-here,secure-key-2-here

# Comma-separated origins
ALLOWED_ORIGINS=https://app.example.com,https://another-domain.com

# ========= RATE LIMITING =========
# For production: use redis://localhost:6379/0
# For dev: memory:// (single instance only)
RATELIMIT_URI=memory://

# ========= DATABASE =========
DATABASE_URL=sqlite:///forms.db

# ========= NOTES =========
# 1. NEVER set DEBUG=True in production
# 2. API_KEYS MUST be set (will fail startup without it in production)
# 3. ALLOWED_ORIGINS MUST be set in production
# 4. Generate strong keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 5. Use environment variable manager (AWS Secrets, HashiCorp Vault, etc.)
